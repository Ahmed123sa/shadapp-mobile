# Copy this file to assets/env.txt and fill in the right values for your
# target environment. assets/env.txt is gitignored — never commit it.
#
# For a RELEASE build this MUST be a real HTTPS production host. main.dart
# will refuse to start a release build if API_BASE_URL still points at
# localhost/127.0.0.1 or uses plain http://.

API_BASE_URL=https://api.your-production-domain.com/api
REVERB_HOST=your-production-domain.com
REVERB_PORT=443
REVERB_KEY=CHANGE_ME
